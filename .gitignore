# pyenv
#   For a library or app, you might want to share your .python-version.
#   Comment under the line if you do.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used with a library, it should be ignored.
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be submitted to version control or not.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be submitted to version control or not.
#   pdm.lock

